.{
    .name = .geode_client_zig,
    .version = "0.2.1",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        // Updated 2026-04-28 (otel rollout): bumps the whole devnw/zig stack
        // to its OTel-aware tags. Each upstream now exposes a lazy `otel`
        // dep gated behind `-Dwith_otel=true`; default builds never resolve
        // it. Transitive deps converge on thread_pool 0.2.1 (1674ebb), so
        // the pin below has to match.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#829d71591d0dcdb7c7194e3ccf7882b46d9a5a66",
            .hash = "quic-0.1.14-gBIqUcO_OQC3sQRFubDSISp4elkPg8UNkW6ZYuLOIzni",
        },
        // TLS 1.3 library for QUIC (must match the version quic v0.1.14 uses)
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#cf62bd12553a6168c2ab0ea3249b7d417cc73864",
            .hash = "tls-0.2.0-mtEaLBxpEwCmZqFrXczu0nd3kYqEzzHCNRl0ukhFCmuw",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#ed09a523e9a31079de16bf4de0792031e523a28a",
            .hash = "dns-0.1.0-x4U-zSE9EQAf_e5_eopOHAKOyrD-PpINQDkA-D61bScJ",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#cbb1c620cb93965c8f5b9b3eef5a37316c24c068",
            .hash = "json-0.1.0-tOue4cGpCwAKMCTJquFbHz9Im68cXcHRzLQKBJwYpsxv",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#90ac948687c8450281e34a9f76f1a30b76801120",
            .hash = "config-0.1.0-TiLumvdgCgBRpbDBUASCxIrTWsLtBoTYx7cJ8n7dG_CD",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#fdd19111b94864524d92ded977d7d1cfd907e419",
            .hash = "slog-0.1.0-SamED3i2BgC_UgpeweAwmLcYlYK-HNd9Q36w32_DTcvr",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#391eb1fad7cb03f538bbacfabf42ce87c338cca2",
            .hash = "uri-0.1.0-zVvOsYtkAgAQEJhEABMyG8Z1GavmW2ZGolz6bI-HMHRO",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#66fddcc8fa480520908c78278ada98a662a15e82",
            .hash = "strings-0.1.0-adMOtWtxJgAlC2O_VSdX0R0vUZj7sw9p4_CLMLBzF5-A",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#3d127c762beaa4f49c7f29f06e5bf0797b63a7e0",
            .hash = "uuid-0.1.0-tL1irrA0GAAhI5QEtixpAw_YWRRXXLRiYUXrlvcMlfM2",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#0a995f839f435d710a0d0f22ddd4593045eb46b8",
            .hash = "auth-0.1.0-W76ZZzZ2AQClt3gkYBphfNP9RKkMZR9Y_jJUhYAuCYe8",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#566f8e66c1e06bcf3b007987fddb3473531ad9b7",
            .hash = "advanced_types-0.1.0-pbHnCsviAgAwhdbQhsZ2h8mgMLmvHpWNNaQmptlbL55X",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#ab424e12ce7f389df95e119a1812ec67d18a1389",
            .hash = "gql-0.1.0-T1ANDcD3CACI9KRgbhXisQKRN1_M8DQ0trV7gqYP0usY",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git#e625409a0c89c64b582e921942aa0d919a2f3cb3",
            .hash = "metrics-0.1.0-uPGXFhzPAQBwtfFZPwU5Cla3FCYKivjlcQY9RXe8QJqo",
        },
        // Thread Pool - direct (replaces the concurrency wrapper).
        // PINNED to the commit that transitive deps (quic, dns, gql,
        // etc.) also resolve to so the module graph has ONE thread_pool.
        // Otherwise zig errors with "file exists in modules
        // build_options and build_options0".
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#930d41bcd52b0f92f5405da69a72949a970a2990",
            .hash = "thread_pool-0.2.1-11B1BobIdgAJ7WWVFfqS0BxtbO_vXdSevdXwauTZhSuS",
        },

        // =======================================================================
        // OpenTelemetry (lazy)
        // =======================================================================
        //
        // OTel client library. Lazy: only resolved when
        // `-Dwith_otel=true` is passed to `zig build`. Default builds
        // never fetch this package, and the produced artifacts contain
        // zero otel symbols (the seam in `src/observability.zig`
        // collapses to comptime-known no-ops via `build_options.with_otel`).
        //
        // PIN MUST MATCH the otel commit referenced by every transitive
        // dep (quic, dns, gql, slog, metrics, thread_pool). Otherwise
        // a `-Dwith_otel=true` build resolves two distinct otel module
        // identities and Zig fails with
        // "file exists in modules otel and otel0".
        //
        // To bump: change the SHA + hash here AND in every upstream's
        // build.zig.zon, then `zig fetch --save=otel <url>#<sha>`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#2665f64d4fb85f8d7beb6b21f2218317ea2fc05e",
            .hash = "otel-0.1.0-B0v3lrgNNADQwluWDPhv5kY_7L_C1vptqunNkx_Ipzy1",
            .lazy = true,
        },
    },
}
