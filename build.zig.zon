.{
    .name = .geode_client_zig,
    .version = "0.2.1",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.15.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#b91444816092757ee3105abbe3a0cb1c0cf3aff8",
            .hash = "quic-0.1.11-gBIqUbJHNgBd6I4ICCxkuHgmEia2OWOF8B6UEQchxnVW",
        },
        // TLS 1.3 library for QUIC
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#cd7e6dea1fbca12f7c032f598c07fa3c572a1e8c",
            .hash = "tls-0.1.1-mtEaLMy7EQCPgW8w_8WYgUn74ggWq6H4tQbEXZYizlhl",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#351c3f3f7293695adce412943dde733b1731adc2",
            .hash = "dns-0.1.0-x4U-zWrTEAAB6G15MLf1Ea_rZWV-ydPN-dRgbfRzNIuq",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#e71f376a5b8311ed833472a8ce1c481bdae260aa",
            .hash = "json-0.1.0-tOue4R6nCwAaJ1kf7Cw1o-ToL-5CCLxY2o7eq-TnmTaL",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#e399961f2a684532396eb13ccb3a58c4f7d0a21a",
            .hash = "config-0.1.0-TiLummVcCgBQ77Qp086M5SbCVXtv2kXDdEHBgmX3IAHO",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#2c7976bf0bc09d5fcd6774ea9363a7fc5c95cc89",
            .hash = "slog-0.1.0-SamEDwJFBgC7gA7Lz1nGGXN6oeB2uMCXkP8OB-UuspdJ",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#dc856b703d8acd0949b63c8f0e86cdb000dbd105",
            .hash = "uri-0.1.0-zVvOsTxgAgDEM4eyjt9rvYOyLTpqt3NGGn0-9oPOhAa1",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#7ca000bdc50736c78a59bb91cfe9e59d25708244",
            .hash = "strings-0.1.0-adMOtaJuJgB3vMD_FfD2nZWmQcL5BKY62KbHAlNLY_G2",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#5836d2f1ae548e1bb4d5340ab5ae8321607bd702",
            .hash = "uuid-0.1.0-tL1irpURDABkTJF9k8lcZNGWN-KNZnVQTi3cT9a9jguR",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#74a3afab57d6a286f5fb6ebd043a85987f8a0aa7",
            .hash = "auth-0.1.0-W76ZZ3UBAQAAYOL9rx0rk9bQ0sTr63ZPLjbPu6yN3xWM",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#d75714987f4689cc902590fe1ae45583ab864eb3",
            .hash = "advanced_types-0.1.0-pbHnCtw-AgDAdsufaeR7F6-jj8PERUbCIvO_O8zHX7VX",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#49b3a5e666f0d2cd50cadd5fc2fc8e5eb69ee48d",
            .hash = "gql-0.1.0-T1ANDQ2QCAA3NJXLmm1Mj_mjLJkzvW2Ng2BYPZufQoQx",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git#3fd133e151d0e9e845b56e131a1ba9539e4149f1",
            .hash = "metrics-0.1.0-uPGXFkNmAQCerT2c-AN7OOWm8eo8H6xhrNqVZyTZVQ5M",
        },
        // Thread Pool - direct (replaces the concurrency wrapper).
        // PINNED to the commit that transitive deps (quic, dns, gql,
        // etc.) also resolve to so the module graph has ONE thread_pool.
        // Otherwise zig errors with "file exists in modules
        // build_options and build_options0".
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#56c109a355eb4316450a216a74cc619b7809183b",
            .hash = "thread_pool-0.2.0-11B1Bsw4RACrT8yj1Moe2s1sdiDixZE3LPlbj3xLYXDG",
        },
    },
}
