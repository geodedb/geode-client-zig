.{
    .name = .geode_client_zig,
    .version = "0.2.9",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        // Updated 2026-05-27: aligns the devnw/zig stack with QUIC v0.1.21
        // and the converged high-concurrency dependency graph. Each upstream
        // exposes a lazy `otel` dep gated behind `-Dwith_otel=true`; default
        // builds never resolve it. Transitive deps converge on thread_pool
        // 0.2.4 (39528a3), so the pin below has to match.
        .quic = .{
            // Must match geode's pin so the build graph has a single quic
            // module instance.
            .url = "git+https://gitlab.com/devnw/zig/quic.git#26fce0db280fafa2813689794e6ef460fa8c15aa",
            .hash = "quic-0.1.21-gBIqUdcpPAAbR3Ybo-aTBBUYSnaoNA4ZOOZaA0P8b4RQ",
        },
        // TLS 1.3 library for QUIC (must match the version quic v0.1.21 uses)
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#e8c137941cb34eefcb63d2612f7932e1dee617c6",
            .hash = "tls-0.1.7-mtEaLPZoEwA9tn7-VIvQted5CwyhCInQiDAR4_MOahQa",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#02c0ead0fd6757e8f087c8db71cc30f90853f92f",
            .hash = "dns-0.1.7-x4U-zZg-EQDgSh8hT9gcDCnVuPNtMWIkqaq8IbyIPggl",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#284b1390d3f03498a4dd022d70d178823370e8ff",
            .hash = "json-0.1.4-tOue4cGpCwBArfMl05wHmwv39pKM9-tjODxrMFm_sIk3",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#dbf3ceaba175cf196a1ae7806b90bcd5ec0df009",
            .hash = "config-0.1.4-TiLumvdgCgCi-N6NyOTB85Erl-hseWjkXhlhFIz1Aju8",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#bd50a7fdbc3e9ce77e66278910bf1b33af045ef3",
            .hash = "slog-0.1.6-SamED7q0BgDuLGxkg2cuBmFY1cA7q8ePuABqfTwXzSEn",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#01d10ef1c896eccfccce44bc16a65768dc9d555f",
            .hash = "uri-0.1.4-zVvOsYtkAgBOyzTsOMvKvsYITqvF2fq-1oPlRRSX66at",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#8dbcf3357459b2367da888a65c41bb03bc7e9cb4",
            .hash = "strings-0.1.3-adMOtWtxJgCuhI1dhMM4aHsedT6pnOpPTK59e_qlhLZC",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#9bd6057558fc3f4f8bce0df003fb02eadaf0e712",
            .hash = "uuid-0.1.1-tL1irrA0GABCD1IFLc0L_1SMfcWxyUTcYV0NSCuvbuxI",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#1d16484f7b1e3d64b2bbeedfac9d175f1217806d",
            .hash = "auth-0.1.4-W76ZZ613AQCuAKP2Z5Xus2YDw41MTmqPCaLMr_Kxr8NT",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#6806c49e630d738e9a858276ce29fe02b4b70376",
            .hash = "advanced_types-0.1.2-pbHnCsviAgC6i8N46mzaVxt97Y5B8yIazG9UaPotlTnQ",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#d8cd6b7b5837187d5fa6a9ebf2d3f2e72b8daf3f",
            .hash = "gql-0.1.3-T1ANDTf5CAClOkfhCilT0d6OdI8_9Lke7wz0epBh1X68",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git#ffe99df789d25f99577534dd93b738a451cc9120",
            .hash = "metrics-0.1.3-uPGXFpXMAQAKUaLg1NwiRB4XeDjiC6F1VPRud9FyN5eY",
        },
        // Thread Pool - direct (replaces the concurrency wrapper).
        // PINNED to the commit that transitive deps (quic, dns, gql,
        // etc.) also resolve to so the module graph has ONE thread_pool.
        // Otherwise zig errors with "file exists in modules
        // build_options and build_options0".
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#39528a3e92212efab8ed5840bc20e619a419c0f5",
            .hash = "thread_pool-0.2.4-11B1BnyUdgCUNlqgBwHNvE4plLwP1s1MAyCjODPafrpo",
        },

        // =======================================================================
        // OpenTelemetry (lazy)
        // =======================================================================
        //
        // OTel client library. Lazy: only resolved when
        // `-Dwith_otel=true` is passed to `zig build`. Default builds
        // never fetch this package, and the produced artifacts contain
        // zero otel symbols (the seam in `src/observability.zig`
        // collapses to comptime-known no-ops via `build_options.with_otel`).
        //
        // PIN MUST MATCH the otel commit referenced by every transitive
        // dep (quic, dns, gql, slog, metrics, thread_pool). Otherwise
        // a `-Dwith_otel=true` build resolves two distinct otel module
        // identities and Zig fails with
        // "file exists in modules otel and otel0".
        //
        // To bump: change the SHA + hash here AND in every upstream's
        // build.zig.zon, then `zig fetch --save=otel <url>#<sha>`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#455ad2b8fb6888d5dab48a0a5bdcc81fd225f635",
            .hash = "otel-0.1.5-B0v3lvEMNAC40_D5FfUJgpR3hR8nP5R4IKg31uJmpk-y",
            .lazy = true,
        },
    },
}
