.{
    .name = .geode_client_zig,
    .version = "0.2.1",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        // Updated 2026-04-28 (otel rollout): bumps the whole devnw/zig stack
        // to its OTel-aware tags. Each upstream now exposes a lazy `otel`
        // dep gated behind `-Dwith_otel=true`; default builds never resolve
        // it. Transitive deps converge on thread_pool 0.2.1 (1674ebb), so
        // the pin below has to match.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#d6b60890e7440fd14ac6a1d03484ad9bcb1e6f0a",
            .hash = "quic-0.1.14-gBIqURJ6OQBAfCjY1BtmcVOeQXnWoUd6PkE51-hBUqii",
        },
        // TLS 1.3 library for QUIC (must match the version quic v0.1.14 uses)
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#e8933f61d97d8c534755fa491ebde43d5c7e356c",
            .hash = "tls-0.2.0-mtEaLBhpEwBqBRnxgrGdgFrUPj77nNucMNecTM0sbfzZ",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#d21a9bf850f494f97721a8385124ec0d37dd302f",
            .hash = "dns-0.1.0-x4U-zQE4EQDjcYemckjTGpYoH9ZsoSnJSzU9IJXj084B",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#1cc10b77e648fdacd1a185c59de390cad92ce84d",
            .hash = "json-0.1.0-tOue4cGpCwCANP-tUb193snfTKWV0NLdcVb4_Bz-d83e",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#402bc274f293fd64191b3c9ab5f5d26c6cf416c6",
            .hash = "config-0.1.0-TiLumvdgCgAk1UDzQfr5x2lB_jvLmqyT4vtV2445Qr-z",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#97593b9f4e48322eb45b1899afaa63f9bf369bc0",
            .hash = "slog-0.1.0-SamEDz-uBgB_90dznNlaUGl6bd7dd8W7S4jH-mXI07Af",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#d9bc1f9f6fafc58cd0aea7ff4826d775f5c0f4db",
            .hash = "uri-0.1.0-zVvOsYtkAgAfqsg2EJGWFAyE1CScnxR2dk-3LinmtLwZ",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#6d5fcf63521596861b827dbd0e1be8e576f1e671",
            .hash = "strings-0.1.0-adMOtWtxJgAqW3HU7vOh-VDxVkDNmS7V6ns8qJQfonwW",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#a91e1f832056473860565c10affbe7fac92e4d4a",
            .hash = "uuid-0.1.0-tL1irrA0GADY2e0kOBcNmyil_J5z-4ZGZc1D4u5qPb3G",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#56b3d93a81f69ae064e6c3bfcff671b72af33f17",
            .hash = "auth-0.1.0-W76ZZzJ2AQAXEjF2v_IVPSNy4iQnJ_HVcbZWt2vH7p22",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#7861b2ca7851fed5ba9fcf42750e41c070c81791",
            .hash = "advanced_types-0.1.0-pbHnCsviAgAwhdbQhsZ2h8mgMLmvHpWNNaQmptlbL55X",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#19f900656a549326e114da54f1ad7c8020f334b1",
            .hash = "gql-0.1.0-T1ANDSbyCAC9sJjmrQT1_juauzN83QIhkjJ8-SkFgV1O",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git#ac6210c7289e60bb0e644b17b0f68a1e109d85a2",
            .hash = "metrics-0.1.0-uPGXFhjPAQAjIm1O9KUw2BYw86Ev0N6Cv8JnyJ4QEXUP",
        },
        // Thread Pool - direct (replaces the concurrency wrapper).
        // PINNED to the commit that transitive deps (quic, dns, gql,
        // etc.) also resolve to so the module graph has ONE thread_pool.
        // Otherwise zig errors with "file exists in modules
        // build_options and build_options0".
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#1674ebbeb0eed7107e6e488cc9fd7b97a8036966",
            .hash = "thread_pool-0.2.1-11B1BqycdgAPt02YXm95pvBtazxHeJlzMBIUHZ0yTzSa",
        },

        // =======================================================================
        // OpenTelemetry (lazy)
        // =======================================================================
        //
        // OTel client library. Lazy: only resolved when
        // `-Dwith_otel=true` is passed to `zig build`. Default builds
        // never fetch this package, and the produced artifacts contain
        // zero otel symbols (the seam in `src/observability.zig`
        // collapses to comptime-known no-ops via `build_options.with_otel`).
        //
        // PIN MUST MATCH the otel commit referenced by every transitive
        // dep (quic, dns, gql, slog, metrics, thread_pool). Otherwise
        // a `-Dwith_otel=true` build resolves two distinct otel module
        // identities and Zig fails with
        // "file exists in modules otel and otel0".
        //
        // To bump: change the SHA + hash here AND in every upstream's
        // build.zig.zon, then `zig fetch --save=otel <url>#<sha>`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel#20078af231c069d88eaeb79dcf950b94366be624",
            .hash = "otel-0.1.0-B0v3lsl9MwCHrG8GDrxdFebugqjybfr4KAiplOJKCRG7",
            .lazy = true,
        },
    },
}
