.{
    .name = .geode_client_zig,
    .version = "0.2.1",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.15.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#7fea7a497fa82b50b2e87c1c65b9e86e3b58a8f0",
            .hash = "error: unable to create fetch stream: EndOfStream",
        },
        // TLS 1.3 library for QUIC
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#6268309512a672b80cece415dde6ee174ad63ac4",
            .hash = "tls-0.1.1-mtEaLO-3EQDynh-BqAw027sLkw97LXmJ8x1y8svAj6IG",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#394883190e2b0eab326b8a12f78f8a2a971518c7",
            .hash = "dns-0.1.0-x4U-zalRDAB_AzP3BWzD_pFniX_3vYu6MNffJgv7uYPg",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#f8924477c708ee0ecc546003175dbb60540e1339",
            .hash = "json-0.1.0-tOue4QSpCwCpF5cK2b-gB_Hanst_Btx76cS4JrKRBdhj",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#fe9d0f6079c08ec21f67919f9cfb983558e46dda",
            .hash = "config-0.1.0-TiLumgsaBwCOJYQ2nMfDL25TYR3cBVOLB0pl5UULr5xk",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#6bc979dc69cc508d551bae82b46e77bfa45627cc",
            .hash = "slog-0.1.0-SamEDy49BACAyugNCCZZoLkHS9t8XAMIhTE9Nnnt1Qua",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#2b27b53d64d67d92439282aa35cc3bc2a96c0674",
            .hash = "uri-0.1.0-zVvOscCwAQDMv-46SmW70_KEIx_UKYuIm4FEoRW7_7kK",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#b66264fe42f1355cd20dd180ed265ddb357205fe",
            .hash = "strings-0.1.0-adMOtR2yHAA6IG1UsFrSw34bxO2pZQSQEsMDX9n11l7C",
        },
        // Spice - Fork/join parallelism
        .spice = .{
            .url = "git+https://gitlab.com/devnw/zig/spice.git#bbf106dc8131a514a4d1687cc2173f124f5c8181",
            .hash = "spice-0.0.0-HnDb58jJAACojBd1dquGT-Ngc6TORlC6izlAKf0f4Rno",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#8cdb557c8eff300024bee366910d07d48a0fc1d7",
            .hash = "uuid-0.1.0-tL1irlIADAAxQDmRzbR1y1LDpYQ4kECnByt-CzlET8HW",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .@"auth" = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#0c0d858d95922cda5cdb66ad01d7c7ed7ad62554",
            .hash = "auth-0.1.0-W76ZZ2D9AAAe7QW8998qeZ4dfo-bIYI4f_sVkaf_0igh",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#c7e8b3ce3fb947e631e60832f570f43180de725a",
            .hash = "advanced_types-0.1.0-pbHnCtw-AgDAdsufaeR7F6-jj8PERUbCIvO_O8zHX7VX",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#c9145b8aae3a57eb3436a380f332deb60aea753c",
            .hash = "gql-0.1.0-T1ANDYqLCAAJHOhJBVqrV_KBvQwXsobgpLIGoiBRFqCV",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git#c583bf47b8325bdd961687e95e4cb54505a5dc45",
            .hash = "metrics-0.1.0-uPGXFkQsAQARWdyIIeww-eHO0Y0G1DHOAFDM-4Ju8j8-",
        },
        // Concurrency - Thread pool and bounded MPMC queue
        .concurrency = .{
            .url = "git+https://gitlab.com/devnw/zig/concurrency.git#fb0aa99f05edca429c02e39cc69905f1a59d97f7",
            .hash = "concurrency-0.1.0-MDWSwkvAAABjTnaUeUKLgjhjT3tpcmxY0XNWKzBDZutH",
        },
    },
}
