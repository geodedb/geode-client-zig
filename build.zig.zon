.{
    .name = .geode_client_zig,
    .version = "0.2.1",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.15.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        // Updated 2026-04-16: pin forward to 51c1a03 — includes the UAF fix
        // in Endpoint.processExpiredTimers and the 5 ms cadence port in
        // QuicStream.readLine (handshake stall fix). Must match the geode
        // repo's quic pin so the module graph stays single-copy.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#4ec548015d82cf4ea7d69ca9d03044f36855ff75",
            .hash = "quic-0.1.11-gBIqUcqNNgBI2mPRzuNBCWP4XZMbcd5ld1EHRoMAHdQu",
        },
        // TLS 1.3 library for QUIC
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#2d9525df250be5468630d24e816281c36155ad9c",
            .hash = "tls-0.1.1-mtEaLJW-EQCOS-dR6IqpkPfpqDX9MCT3dc6Dpk-aoPeI",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#ace8ae1828d2c32ab63bef30d7c911032052b27b",
            .hash = "dns-0.1.0-x4U-zXfVEADPvmG45g-wY6aiCdiDB_PtFTGbtJQi_b91",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#5c7d026aa16133430421ac06328c20752b12004a",
            .hash = "json-0.1.0-tOue4cGpCwCd2HbLha5flC5NUj5sqRJTTVUdpXsuFjbV",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#118f5e92b3f8884c027316018114ed61bef23dd7",
            .hash = "config-0.1.0-TiLumgFhCgCdI3bAbqq0_8oCGHZbb0tGA-fWs-UnagQB",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#629b871880bc5416ee55bed76c0a45920877ea5c",
            .hash = "slog-0.1.0-SamEDyVLBgAxzqQu1ZwVCRQy1BDRg9ggFJb3xoD5iM6f",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#7b47c084c16c9ff5601abdfb9cdd9fb1c04d6d9a",
            .hash = "uri-0.1.0-zVvOsYtkAgDslbRjHg2zUphr6xN8hBBU8KgaIvLcT1rK",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#065a81afbcaf9441e1d53e431e69fcab577502c4",
            .hash = "strings-0.1.0-adMOtWtxJgAU-b8p0M-88golx7t52Plc40GW7VNFxEvw",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#fb55af68a0a5216999f7eff0ba0b0f92a8970deb",
            .hash = "uuid-0.1.0-tL1irmYTDACHEvxkOsz2sXNeNmWF6ePj36TEptpsTsTN",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#ff44150a28f885314d5ac9e54e18777b55196c5a",
            .hash = "auth-0.1.0-W76ZZ3UBAQAAYOL9rx0rk9bQ0sTr63ZPLjbPu6yN3xWM",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#52cce4dfdb1304c4dc29755bb03d31ef5a19cdfa",
            .hash = "advanced_types-0.1.0-pbHnCtw-AgDAdsufaeR7F6-jj8PERUbCIvO_O8zHX7VX",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#dc332d0d4fe0e4cddb3a5e5ac1964d4159ee9d92",
            .hash = "gql-0.1.0-T1ANDQ2QCAAj5GddXCe37tGauHMy9yalNOPwCfHZb-Oq",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git#40c48ef7d34de4424824c2cd54ad565c495b160e",
            .hash = "metrics-0.1.0-uPGXFrKCAQBemuMFcg3VHttTpcv85nSwzIwYaTJU9BpJ",
        },
        // Thread Pool - direct (replaces the concurrency wrapper).
        // PINNED to the commit that transitive deps (quic, dns, gql,
        // etc.) also resolve to so the module graph has ONE thread_pool.
        // Otherwise zig errors with "file exists in modules
        // build_options and build_options0".
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#c087f24f9625a6f8260a8ed626110827417df349",
            .hash = "thread_pool-0.2.0-11B1Bg_fdQDMMQ_Cdi6Q3Sj7Ao-4AGVORmIbyM0LUQO8",
        },
    },
}
