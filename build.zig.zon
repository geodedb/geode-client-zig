.{
    .name = .geode_client_zig,
    .version = "0.3.21",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        // Updated 2026-05-27: aligns the devnw/zig stack with QUIC v0.1.21
        // and the converged high-concurrency dependency graph. Each upstream
        // exposes a lazy `otel` dep gated behind `-Dwith_otel=true`; default
        // builds never resolve it. Transitive deps converge on thread_pool
        // 0.2.4 (39528a3), so the pin below has to match.
        // 2026-05-28: picks up the trusted-localhost cwnd bypass used by
        // Geode's high-fanout loopback integration tests while preserving the
        // normal congestion gate for remote peers.
        // 2026-05-28: also includes the sent-packet legacy map mutex needed
        // for multi-poll-worker PTO accounting under high fan-out.
        // 2026-05-28: serializes PTO dirty recompute on conn.mu so timer
        // arming cannot race high-parallel STREAM writes.
        // 2026-05-28: keeps ephemeral client UDP ports unique under fan-out so
        // server responses cannot be delivered to another client's socket.
        // 2026-05-28: serializes per-connection TLS Context access so
        // concurrent poll workers cannot race pollCrypto ownership drains.
        // 2026-05-28: restores the proven wider server short-header drain
        // after rejecting one-batch, two-batch, and packet-shedding variants.
        // 2026-05-29: defers the first server-side STREAM-only standalone ACK
        // so request/response traffic can piggyback ACKs on response packets
        // while retaining an AppAckDelay fallback for quiet/upload-only peers.
        // 2026-05-29: restores the proven four-batch server drain after the
        // short-header wall-clock yield experiments regressed Geode's accepted
        // 4096 single-op gate.
        // 2026-05-29: pins the upstream-main revert of a slow-batch cadence
        // experiment that regressed Geode's accepted 4096 single-op gate.
        // Content remains equivalent to the proven 108d06d four-batch receive
        // behavior, but downstream pins now track the latest upstream commit.
        // 2026-05-29: pins REQ-QUIC-HC-168 so generic/coalesced long-header
        // dispatch uses the same per-connection TLS serialization as the
        // optimized burst receive path, closing the pollCrypto ownership race.
        // 2026-05-29: pins a1858c1, reverting the rejected
        // REQ-QUIC-HC-177 busy-connection shedding experiment after Geode
        // 2048x8 mixed traffic lost first responses.
        .quic = .{
            // Must match geode's pin so the build graph has a single quic
            // module instance.
            // 2026-06-14: v0.1.27 — api.destroyBatch (acceptor-wedge fix).
            // 2026-06-14: v0.1.28 — acceptor-wedge RC-A: socket-drain cap
            // decoupled from the Initial processing budget (server-side only;
            // client behaviour unchanged). Kept in lockstep with geode's pin.
            // 2026-06-15: v0.1.29 — RC-A iteration 2: small Initial-processing
            // budget + full-drain cap so the kernel rx-queue is actually bounded
            // (server-side only; client unchanged). Lockstep with geode.
            // 2026-06-15: v0.1.30 — RC-C (it.3): wire the dead/churned-connection
            // reaper (idle close + same-peer stale close). Server-side opt-in
            // (dead_conn_reap_ms; OFF by default), so client behaviour unchanged.
            // Lockstep with geode. NOTE: the v0.1.30 tag commit (245ecae) predated
            // its own build.zig.zon .version bump, so its content hash was labelled
            // 0.1.29 — pinned by commit, so reproducible; matched geode exactly.
            // 2026-06-17: v0.1.31 — GAP-0900 lever (a): move endpoint.pollWithStats's
            // 256 KiB receive scratch from a stack `= undefined` (0xAA-filled every
            // poll cycle in ReleaseSafe, across 16 poll threads) to threadlocal
            // static. API-compatible (no signature change); client behaviour
            // unchanged. Lockstep with geode. .version now tracks the tag (0.1.31).
            // 2026-06-23: v0.1.33 — FIPS stack bump: quic links against the
            // FIPS-enabled tls v0.1.16 backend. API-compatible; client behaviour
            // unchanged. Lockstep with geode.
            // 2026-11-12: v0.1.49 — bounds ACK and loss-recovery work per packet
            // (SONNY-6434). API-compatible; lockstep with geode.
            // 2026-11-17: v0.1.55 — key-update desync, handshake RTT sample,
            // exclusive UDP binds (0.1.52, SONNY-6522); packet-number length,
            // coalesced STREAM retransmission, no reused packet numbers
            // (0.1.53/0.1.54); ACK ranges and writer/ACK lock fairness
            // (0.1.55, SONNY-6673). API-compatible; lockstep with geode.
            // 2026-11-18: v0.1.56 (54491db, SONNY-6630) — otel v0.1.30 (lazy), so
            // one otel/thread-pool tree; no transport change (test-only fixes since
            // v0.1.55). Lockstep with geode.
            .url = "git+https://gitlab.com/devnw/zig/quic.git?ref=v0.1.56#54491db86e1aceec79b80053938a67c0ec1e772f",
            .hash = "quic-0.1.56-gBIqUQlKRwAs1d-cRuoA3iM__-rxYczHsSkBSy3waYeZ",
        },
        // TLS 1.3 library for QUIC (must match the version quic v0.1.33 uses)
        // 2026-06-23: v0.1.16 — FIPS stack: tls gains OpenSSL FIPS backend wiring.
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git?ref=v0.1.28#7c47cf94b2e505110027bd7d0ac4fbe6b1e5aa35",
            .hash = "tls-0.1.28-mtEaLO8yKwAxN3fveAslKwXiuuErF7Eg17tQCezqoNSN",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.29#3c184d3678ee8709f47a7f5ec58cba17376dc5d7",
            .hash = "dns-0.1.29-x4U-zSeCGACiftNR0oJoHugYo1ElseP7po9H8LkiXyNO",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git?ref=v0.1.21#a73791a1fe2365949db02ba7eb5a4fb91fdd7f69",
            .hash = "json-0.1.21-tOue4YaW6ACrNXeY2rLSDiON1ZH5jRpB_riq5dqzbKyP",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git?ref=v0.1.19#25a1eba6d04340ec2b9a6f8efd22bec9d488c6ef",
            .hash = "config-0.1.19-TiLumvqyDABNujdbGvFqsIj3aAt7LdDphgGhqdU31Y3q",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git?ref=v0.1.16#b525a9e1784be2bc9d1c61da724deae84b514310",
            .hash = "slog-0.1.16-SamED1H5BwCeK8xauLkBgS6gCBEgN6wWnhSLWW2tbPZy",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git?ref=v0.1.17#5dcd7d203ad3b81de01a31c28e8c396f45c6b50e",
            .hash = "uri-0.1.17-zVvOseOkAgC_LhhYsTrPtJvjRDPzhvL4hJLoEDA2XwdW",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git?ref=v0.1.7#c43105f1b847aeecc081279675482599f17bd3a9",
            .hash = "strings-0.1.7-adMOtbcoYwAaTh4bv0HI7C53-uDwzrQQBQyJmpCNLltw",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git?ref=v0.1.10#5547a8a0d86c67315d292f81411f6237ee61cf5c",
            .hash = "uuid-0.1.10-tL1iroznHACRKPV4rc3sSf8tJtvHw8VfF-Btd4F1giHh",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git?ref=v0.1.23#c66e50e05f14a714d839c63e16598e8f02c77cd1",
            .hash = "auth-0.1.23-W76ZZzjwAgAqBGyY2To8qNdvJff2taUcJCaM35M5TAsh",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git?ref=v0.1.7#9d398ad846dc7698ce504ed2bc0dfdf106139fdf",
            .hash = "advanced_types-0.1.7-pbHnCpcwBAAiqLvESTBigiEQX2CDEjmVu4E7JkfG9JYo",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git?ref=v0.1.23#b56fcb3076d9a5f36322ce6c72abf118404b9cdc",
            .hash = "gql-0.1.23-T1ANDcpWDACFyCqIAKvNtH4Jfb8aelISperbi7WP6Dcc",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git?ref=v0.1.10#bac700e8655c01891a0c23801f86a0a0adf484a8",
            .hash = "metrics-0.1.10-uPGXFvohAwDdPQYEp_QXrbFU69uLrYNiBCeN1jzdqj8p",
        },
        // Thread Pool - direct (replaces the concurrency wrapper).
        // PINNED to the commit that transitive deps (quic, dns, gql,
        // etc.) also resolve to so the module graph has ONE thread_pool.
        // Otherwise zig errors with "file exists in modules
        // build_options and build_options0".
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.11#666b7ac0cc8b92d5773df5e79ea4fd421bd77e99",
            .hash = "thread_pool-0.2.11-11B1Bk2GegC5mn18xNrkmF0lMrgrWqijO7PXmftrkuSe",
        },

        // =======================================================================
        // FIPS crypto seam (lazy)
        // =======================================================================
        //
        // OpenSSL FIPS backend. Lazy: only resolved when `-Dfips=true` is
        // passed to `zig build`. Default builds never fetch this package, and
        // the produced artifacts contain zero OpenSSL symbols (the seam in
        // `src/crypto_backend.zig` delegates to the local std_shim instead).
        //
        // Tag v0.1.0 is the first published stable release. The hash below was
        // captured via `zig fetch --save=fips <url>` against that tag.
        .fips = .{
            .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.3#f7395a3bab363d75b651be0775f43dd037c14a9c",
            .hash = "fips-0.1.3-1wf3natvCACgXCcDLw4o0KwZtrNNpXyyRp1hNIA9oi2m",
            .lazy = true,
        },

        // =======================================================================
        // OpenTelemetry (lazy)
        // =======================================================================
        //
        // OTel client library. Lazy: only resolved when
        // `-Dwith_otel=true` is passed to `zig build`. Default builds
        // never fetch this package, and the produced artifacts contain
        // zero otel symbols (the seam in `src/observability.zig`
        // collapses to comptime-known no-ops via `build_options.with_otel`).
        //
        // PIN MUST MATCH the otel commit referenced by every transitive
        // dep (quic, dns, gql, slog, metrics, thread_pool). Otherwise
        // a `-Dwith_otel=true` build resolves two distinct otel module
        // identities and Zig fails with
        // "file exists in modules otel and otel0".
        //
        // To bump: change the SHA + hash here AND in every upstream's
        // build.zig.zon, then `zig fetch --save=otel <url>#<sha>`.
        // 2026-06-23: bumped to v0.1.14 to match quic-0.1.33's otel pin.
        // auth v0.1.9 / dns v0.1.14 / gql v0.1.8 were also released on otel
        // v0.1.14, so the (lazy, -Dwith_otel) otel/tls diamond is fully
        // closed — detect-diamond-deps clean (22 packages, 0 diamonds).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.30#dbf58bae612ef3f5f78c62c130b4c6d63f5aa297",
            .hash = "otel-0.1.30-B0v3lrGuNQDL0D3_KAb6qK6MaYmz2QeutCp0Sg3SL1H7",
            .lazy = true,
        },
    },
}
