.{
    .name = .geode_client_zig,
    .version = "0.2.1",
    .fingerprint = 0x13ee9771571b2bf3,
    .minimum_zig_version = "0.15.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "geode_client_v2.zig",
        "src",
        "tests",
        "benchmarks",
        "fuzz",
        "LICENSE",
    },
    .dependencies = .{
        // =======================================================================
        // Core Transport & Encoding
        // =======================================================================

        // QUIC v1/v2 protocol implementation (RFC 9000) - primary transport
        // Updated 2026-04-16: pin forward to 51c1a03 — includes the UAF fix
        // in Endpoint.processExpiredTimers and the 5 ms cadence port in
        // QuicStream.readLine (handshake stall fix). Must match the geode
        // repo's quic pin so the module graph stays single-copy.
        .quic = .{
            .url = "git+https://gitlab.com/devnw/zig/quic.git#ede1b305a5e72921130c9addba7ac135cddc90f2",
            .hash = "quic-0.1.11-gBIqUfKQNgCVumcHNPOO2E40sZJCgxZPvdvlu87JcrID",
        },
        // TLS 1.3 library for QUIC
        .tls = .{
            .url = "git+https://gitlab.com/devnw/zig/tls.git#8453b30e3868fa5a3fc4ac49bd671eb25962f8e8",
            .hash = "tls-0.1.1-mtEaLJW-EQD6ED9LTRLNbvijVL0kpr0uICMWyiISZg7w",
        },
        // =======================================================================
        // Foundation Libraries
        // =======================================================================

        // DNS resolution - RFC 1035 compliant with caching and DoT/DoH/DoQ
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#3f4ff376433203021439eeb0785e2e0b1dc4c5cb",
            .hash = "dns-0.1.0-x4U-zRbYEADpx1_cj2pe_dES9O_B0-MjW-jA_g3hWXez",
        },
        // JSON parser/encoder - RFC 8259 compliant
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#30b3983dfaab83ebc827205567c32542e111616b",
            .hash = "json-0.1.0-tOue4cGpCwCGYhHHbM0EF6LxFTxPS2s9rcbKRD-o5xW7",
        },
        // Configuration management - XDG compliant, multi-format
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#7eda77bda98f5bf48570f43ec292ec9219f71480",
            .hash = "config-0.1.0-TiLumu9gCgAHypciAx8sv9vlgG6b-BjAAjdtL47r3raM",
        },
        // Structured logging - slog-style with multiple handlers
        .slog = .{
            .url = "git+https://gitlab.com/devnw/zig/slog.git#65e0792d4140a736fb1e04a7b1ee84c9333d58a9",
            .hash = "slog-0.1.0-SamEDyVLBgDLhCULhAYXGTkLtFFch_zMfAj8MRz2E3Cb",
        },
        // URI/URL parsing - RFC 3986 compliant
        .uri = .{
            .url = "git+https://gitlab.com/devnw/zig/uri.git#4b333e02b170022b7e724783702914ed24abafd8",
            .hash = "uri-0.1.0-zVvOsYtkAgA5xW6KzmyWVBhb9qWWJKp5jp-kJgmMNyh7",
        },
        // Unicode string library with SIMD acceleration
        .strings = .{
            .url = "git+https://gitlab.com/devnw/zig/strings.git#a4e0566cb73123c95a887e82da283858658e6f15",
            .hash = "strings-0.1.0-adMOtWtxJgD0_SKjaeHUaLKTbnogEUC8DJtXy6Qjb_uE",
        },

        // =======================================================================
        // New Client Libraries (aligned with Geode server)
        // =======================================================================

        // UUID - RFC 9562 compliant (V1-V8), k-sortable V7
        .uuid = .{
            .url = "git+https://gitlab.com/devnw/zig/uuid.git#cede45bed26d9e1c11cb0234fb0014807c9c8bef",
            .hash = "uuid-0.1.0-tL1irrcPDAAPFdwSHWfwiKCC9lvvYGu6U0XH8efaTXP_",
        },
        // Auth - HMAC chain, API keys, TOTP/MFA primitives
        .auth = .{
            .url = "git+https://gitlab.com/devnw/zig/auth.git#ff44150a28f885314d5ac9e54e18777b55196c5a",
            .hash = "auth-0.1.0-W76ZZ3UBAQAAYOL9rx0rk9bQ0sTr63ZPLjbPu6yN3xWM",
        },
        // Advanced Types - Network, vector, geographic, URL, range value types
        .advanced_types = .{
            .url = "git+https://gitlab.com/devnw/zig/advanced-types.git#52cce4dfdb1304c4dc29755bb03d31ef5a19cdfa",
            .hash = "advanced_types-0.1.0-pbHnCtw-AgDAdsufaeR7F6-jj8PERUbCIvO_O8zHX7VX",
        },
        // GQL - ISO/IEC 39075:2024 Graph Query Language front-end (lexer, parser, AST)
        .gql = .{
            .url = "git+https://gitlab.com/devnw/zig/gql.git#220032242bfb19c30fcb27fcc97c45c7e27185be",
            .hash = "gql-0.1.0-T1ANDQ2QCABQaGO7mRaZ1SO1ZEqEplcp1KXDTwyp_SKl",
        },
        // Metrics - Counters, gauges, histograms, Prometheus export
        .metrics = .{
            .url = "git+https://gitlab.com/devnw/zig/metrics.git#cdf63b99240a8c49eefd63475d9d88adcc3dd3ad",
            .hash = "metrics-0.1.0-uPGXFrKCAQDNKbOPVeu3GbohS6f7Jw5sROQeYpu977PZ",
        },
        // Thread Pool - direct (replaces the concurrency wrapper).
        // PINNED to the commit that transitive deps (quic, dns, gql,
        // etc.) also resolve to so the module graph has ONE thread_pool.
        // Otherwise zig errors with "file exists in modules
        // build_options and build_options0".
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#ee8440f69012cad49fa1d5f22fe18c68f944d9ab",
            .hash = "thread_pool-0.2.0-11B1Bj_edQCU0Y_-zzOoXuytAgqEkDkfuw2nB-YxUmEL",
        },
    },
}
